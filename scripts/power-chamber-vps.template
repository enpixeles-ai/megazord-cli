#!/usr/bin/env bash
# ⚡ POWER CHAMBER (remoto/SSH) — plantilla.
# Vigila los 6 Zords trabajando en un servidor remoto, en rejilla 3x2.
#
# CÓMO USAR:
#   1. Copia este archivo a ~/.local/bin/power-chamber-vps  (sin el .template)
#   2. Cambia REMOTE y DIR por los tuyos.
#   3. chmod +x y córrelo.
#
# Requiere tmux (brew install tmux / apt install tmux) y acceso SSH por llave.

REMOTE="usuario@tu-servidor.com"                       # <-- CAMBIA ESTO
DIR="/ruta/a/tu/proyecto/_dispatch"                     # <-- CAMBIA ESTO
S="chamber"

command -v tmux >/dev/null 2>&1 || { echo "Falta tmux"; exit 1; }
tmux kill-session -t "$S" 2>/dev/null

pane() { # $1 color · $2 nombre · $3 rol · $4 log
  echo "ssh $REMOTE \"touch $DIR/$4; printf '\\033[1;$1m'; \
printf '╔══════════════════════════════════════╗\\n'; \
printf '║  %-36s║\\n' '$2'; \
printf '║  %-36s║\\n' '$3'; \
printf '╚══════════════════════════════════════╝\\033[0m\\n'; \
tail -n 40 -f $DIR/$4\""
}

tmux new-session  -d -s "$S" -x "$(tput cols)" -y "$(tput lines)" "$(pane 31 '🦖 TYRANNO · Claude' 'arquitecto · integracion' claude.log)"
for z in "90|🐘 MASTODON · Codex|refactors · tests|codex.log" \
         "34|🛡  TRICERATOPS · Kimi|volumen · scaffolding|kimi.log" \
         "35|🦅 PTERODACTYL · Antigravity|research · QA · docs|gemini.log" \
         "33|🐯 SABERDIENTE · ZCode|contrapunto · pasos acotados|zai.log" \
         "36|🐉 DRAGONZORD · DeepSeek|voz extra · ediciones aisladas|deepseek.log"; do
  IFS='|' read -r col name role log <<<"$z"
  tmux split-window -t "$S:0" "$(pane "$col" "$name" "$role" "$log")"
  tmux select-layout -t "$S" tiled >/dev/null
done
tmux select-layout -t "$S" tiled
tmux set -t "$S" pane-border-status top
tmux attach -t "$S"
