#!/usr/bin/env python3
# 🎬 POWER CHAMBER SIMULADA — 2x2, los 4 Zords escribiendo codigo en vivo.
# Puro show para grabar reels. No ejecuta nada real, no gasta tokens.
import os, sys, time, random, shutil

R="\033[1;31m"; K="\033[1;90m"; B="\033[1;34m"; P="\033[1;35m"
G="\033[1;32m"; Y="\033[1;33m"; W="\033[1;97m"; D="\033[2m"; N="\033[0m"

CH = 9  # lineas de contenido por panel (fijo → nunca se desborda)

ZORDS=[
 {"name":"🦖 TYRANNO · Claude","col":R,"file":"webhook/route.ts",
  "code":["export async function POST(req){","  const brand = getBrand(id);","  const scope = resolve(phone);","  // integracion · nucleo","  await bookAppt(slot);","  return json({ ok: true });","✔ tenant aislado · sin fugas","git commit -m 'core'"]},
 {"name":"🐘 MASTODON · Codex","col":K,"file":"safeguards.test.ts",
  "code":["describe('dedup',()=>{","  it('bloquea dup',()=>{","    expect(isDup(k)).ok;","  });","  it('email pasa',()=>{","    expect(guard(m)).no;","✔ 21 passing (0.16s)","refactor · quirurgico"]},
 {"name":"🛡  TRICERATOPS · Kimi","col":B,"file":"lane_scheduler.py",
  "code":["def run_lanes(q, fn):","  for it in enrich(q):","    lane = detect(it)","    await wait_for(lane)","  # backoff decide","  log({'ok': True})","✔ modulo nuevo · 213 ln","scaffolding completo"]},
 {"name":"🦅 PTERODACTYL · Gemini","col":P,"file":"e2e.spec.ts",
  "code":["test('cross-tenant',()=>{","  await loginAs(B);","  const r = openCase(A);","  expect(r.code).is(403);","  // QA: 4 vectores","  await rateLimit();","✔ E2E verde · 4/4","docs actualizados"]},
]

def render(pos, pw, body, counter):
    buf=[]
    for i,z in enumerate(ZORDS):
        r,c = pos[i]
        head = f" {z['name']} "
        buf.append(f"\033[{r};{c}H{z['col']}┌{head}{'─'*max(0,pw-len(head)-3)}┐{N}")
        buf.append(f"\033[{r+1};{c}H\033[K{D}{z['col']}│{N} {D}~/{z['file']}{N}")
        for k in range(CH):
            line = body[i][k] if k < len(body[i]) else ""
            buf.append(f"\033[{r+2+k};{c+1}H\033[K{line}")
    sys.stdout.write("".join(buf)); sys.stdout.flush()

def main():
    dur = float(os.environ.get("MZ_SECONDS","26"))
    size = shutil.get_terminal_size((110,30))
    COLS = max(60, size.columns)
    pw = COLS//2
    maxw = pw - 5
    PH = CH + 2                       # alto de cada panel (header + contenido)
    pos = [(2,1),(2,pw+2),(2+PH,1),(2+PH,pw+2)]
    banner_row = 2 + 2*PH
    body = [[] for _ in range(4)]
    counter = [0,0,0,0]

    sys.stdout.write("\033[?25l\033[2J\033[H")
    title = "⚡  P O W E R   C H A M B E R  —  4 ZORDS EN LINEA  ⚡"
    sys.stdout.write(f"\033[1;{max(1,(COLS-len(title))//2)}H{Y}{title}{N}")
    sys.stdout.flush()

    bag=[]; start=time.time()
    while time.time()-start < dur:
        if not bag:
            bag=[0,1,2,3]; random.shuffle(bag)
        i = bag.pop()
        z = ZORDS[i]; counter[i]+=1
        raw = z["code"][(counter[i]-1) % len(z["code"])][:maxw]
        ok = raw.strip().startswith("✔")
        color = G if ok else z["col"]
        body[i].append(f"{D}{counter[i]:>2}{N} {color}{raw}{N}")
        if len(body[i])>CH: body[i].pop(0)
        render(pos, pw, body, counter)          # redibuja LOS 4 → simetrico
        time.sleep(random.uniform(0.16,0.34))

    banner = f"{G}✔ MISION COMPLETADA · tests verdes · 0 errores · acta → Telegram{N}"
    sys.stdout.write(f"\033[{banner_row};{max(1,(COLS-60)//2)}H{banner}\033[?25h")
    sys.stdout.write(f"\033[{banner_row+2};1H")
    sys.stdout.flush(); print()

if __name__=="__main__":
    try: main()
    except KeyboardInterrupt:
        sys.stdout.write("\033[?25h\n")
